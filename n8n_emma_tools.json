    {
      "parameters": {
        "jsCode": "// ADR 0007/0008/0010/0019 — compute free slots, earliest-first, 3 max, dual-form dates\nconst cfg = $('Clinic Config').first().json;\nconst req = $('Slots Webhook').first().json.body || {};\nconst args = req.args || {};\nconst tz = cfg.timezone;\n\n// 1. Busy intervals from booked events ([CANCELLED] events do not block — ADR 0015)\nconst busy = [];\nfor (const item of $input.all()) {\n  const e = item.json;\n  if (!e || !e.start) continue;\n  if ((e.summary || '').startsWith('[CANCELLED]')) continue;\n  busy.push([\n    DateTime.fromISO(e.start.dateTime || e.start.date).toMillis(),\n    DateTime.fromISO(e.end.dateTime || e.end.date).toMillis(),\n  ]);\n}\n\n// 2. Search window\nconst now = DateTime.now().setZone(tz);\nconst earliest = now.plus({ hours: Number(cfg.min_notice_hours) });\nconst horizon = now.plus({ days: Number(cfg.horizon_days) });\nconst workDays = String(cfg.work_days).split(',').map(Number); // Luxon: 1=Mon … 7=Sun\n\n// 3. Structured hints from Emma (ADR 0019) — n8n does the date math, never the LLM\nconst WEEKDAYS = { monday: 1, tuesday: 2, wednesday: 3, thursday: 4, friday: 5, saturday: 6, sunday: 7 };\nlet targetDay = null;\nconst wanted = WEEKDAYS[String(args.weekday || '').toLowerCase()];\nif (wanted) {\n  let d = now.startOf('day');\n  while (d.weekday !== wanted) d = d.plus({ days: 1 });\n  targetDay = d.plus({ weeks: Number(args.week_offset || 0) });\n}\nconst dayPart = String(args.day_part || '').toLowerCase(); // '', 'morning', 'afternoon'\n\n// 4. Walk the grid, earliest-first, stop at 3 offers\nfunction collectDay(day, out) {\n  if (!workDays.includes(day.weekday)) return;\n  let t = day.set({ hour: Number(cfg.open_hour), minute: 0, second: 0, millisecond: 0 });\n  const close = day.set({ hour: Number(cfg.close_hour), minute: 0, second: 0, millisecond: 0 });\n  while (t.plus({ minutes: Number(cfg.slot_minutes) }) <= close && out.length < 3) {\n    const s = t.toMillis();\n    const e = t.plus({ minutes: Number(cfg.slot_minutes) }).toMillis();\n    const tooEarly = t < earliest;\n    const wrongPart =\n      (dayPart === 'morning' && t.hour >= 12) ||\n      (dayPart === 'afternoon' && t.hour < 12);\n    const taken = busy.some(([bs, be]) => s < be && e > bs);\n    if (!tooEarly && !wrongPart && !taken) {\n      out.push({\n        iso: t.toISO({ suppressMilliseconds: true }),\n        spoken: t.toFormat(\"cccc, LLLL d 'at' h:mm a\"),\n      });\n    }\n    t = t.plus({ minutes: Number(cfg.slot_minutes) });\n  }\n}\n\nconst slots = [];\nlet requestedDayFull = false;\nif (targetDay) {\n  collectDay(targetDay, slots);\n  requestedDayFull = slots.length === 0;\n  let d = targetDay.plus({ days: 1 });\n  while (slots.length < 3 && d <= horizon) {\n    collectDay(d, slots);\n    d = d.plus({ days: 1 });\n  }\n} else {\n  // week_offset without a weekday: 'in two weeks' -> start searching that far out\n  let d = now.plus({ weeks: Number(args.week_offset || 0) }).startOf('day');\n  if (d < earliest.startOf('day')) d = earliest.startOf('day');\n  while (slots.length < 3 && d <= horizon) {\n    collectDay(d, slots);\n    d = d.plus({ days: 1 });\n  }\n}\n\n// 5. Answer for Emma\nreturn [{\n  json: {\n    slots,\n    offer_only_first: true,\n    requested_day_full: requestedDayFull,\n    no_availability: slots.length === 0,\n    instruction:\n      'Offer ONLY the first slot, reading its spoken field word for word. ' +\n      'Only if the patient declines, offer the next slot. Never list several slots at once. ' +\n      'When booking, send back the iso value of the accepted slot unchanged.',\n  },\n}];"
      },
