    {
      "parameters": {
        "jsCode": "// ADR 0018 — turn Retell's post-call analysis into a status prefix.\n// Cancelled/rescheduled were already stamped mid-call, so they pass through as no-ops.\nconst body = $input.first().json.body || {};\nif (body.event !== 'call_analyzed') return [];\n\nconst call = body.call || {};\nconst dyn = call.retell_llm_dynamic_variables || {};\nconst analysis = (call.call_analysis || {}).custom_analysis_data || {};\nconst status = String(analysis.appointment_status || '').toLowerCase();\n\nlet prefix = null;\nif (status.includes('confirm')) prefix = '[CONFIRMED]';\nelse if (status.includes('no_answer') || status.includes('no answer') || status.includes('voicemail')) prefix = '[NO ANSWER]';\n\nif (!prefix || !dyn.event_id) return [];\nreturn [{ json: { event_id: dyn.event_id, prefix } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 1280],
      "id": "8f4c7d9e-4653-4d95-e11f-101010101012",
      "name": "Pick Status Prefix"
    },
