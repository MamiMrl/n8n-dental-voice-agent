    {
      "parameters": {
        "promptType": "define",
        "text": "=Event Details:\nTitle: {{ $json.summary }}\nDescription: {{ $json.description }}\nStart: {{ $json.start.dateTime }}\nEnd: {{ $json.end.dateTime }}\n\nPlease extract and format this information according to the required structure.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an AI assistant that converts Google Calendar event information into structured JSON data.\n\nExtract the following information from the calendar event:\n- name: Full name of the recipient\n- phone_number: Phone number as a string in e.164 format\n- reason: Reason for the appointment\n- start_time: Start time in ISO 8601 format\n- end_time: End time in ISO 8601 format\n- email: Email address of the recipient\n\nReturn the data in valid JSON format only. Do not include any additional text or comments."
        }
      },
