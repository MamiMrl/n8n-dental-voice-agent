        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from_number\": \"+1XXXXXXXXXX\",\n  \"to_number\": \"{{ $json.output.properties.phone_number }}\",\n  \"retell_llm_dynamic_variables\": {\n    \"name\": \"{{ $json.output.properties.name }}\",\n    \"phone_number\": \"{{ $json.output.properties.phone_number }}\",\n    \"reason\": \"{{ $json.output.properties.reason }}\",\n    \"start_time\": \"{{ $json.output.properties.start_time }}\",\n    \"end_time\": \"{{ $json.output.properties.end_time  }}\"\n  },\n  \"override_agent_id\": \"YOUR_RETELL_AGENT_ID\"\n}",
        "options": {}
      },
